' USER ANALYTICS AND STATISTICS FLOW
' ============================================

@startuml User_Analytics_Flow
title Real-Time User Analytics and Statistics System

actor User as U
participant "Dashboard\nFrontend" as FE
participant "Analytics\nAPI" as API
participant "Statistics\nProcessor" as SP
participant "Database\n(user_games)" as DB
participant "Cache\nLayer" as CACHE
participant "WebSocket\nGame Server" as WS

== Dashboard Statistics Loading ==
U -> FE : Visit dashboard page
activate FE
FE -> FE : Check if user authenticated
FE -> API : GET /api/user-stats/:userId
activate API

API -> CACHE : Check cached stats
activate CACHE
CACHE --> API : null (cache miss)
deactivate CACHE

API -> SP : calculateUserStats(userId)
activate SP
SP -> DB : Query user game history
activate DB
DB --> SP : [game records for user]
deactivate DB

SP -> SP : Calculate aggregated stats:\n- Total games\n- Win/Loss/Draw counts\n- Win rate percentage\n- Current rating\n- Rating changes\n- Current/best streaks\n- Recent performance

SP --> API : {totalGames: 342, winRate: 58.2%, currentRating: 1245, ...}
deactivate SP

API -> CACHE : Store stats (TTL: 5 minutes)
activate CACHE
CACHE --> API : Cached successfully
deactivate CACHE

API --> FE : {stats: {totalGames: 342, winRate: 58.2%, ...}}
deactivate API

FE -> FE : Update dashboard with\nreal user statistics
FE -> U : Display personalized stats
deactivate FE

== Real-Time Game Result Recording ==
WS -> WS : Game completed\n(checkmate/stalemate/resignation)
activate WS
WS -> WS : Determine game result\n& participants

WS -> DB : INSERT INTO user_games\n{userId, result, opponent_type,\n bot_level, moves_count, duration, ...}
activate DB
DB --> WS : Game record saved (ID: 789)
deactivate DB

WS -> SP : updateUserStatistics(userId, gameResult)
activate SP
SP -> DB : Fetch recent user performance
activate DB
DB --> SP : [last 10 games, rating history]
deactivate DB

SP -> SP : Recalculate statistics:\n- Update win/loss counts\n- Recalculate win rate\n- Update current streak\n- Calculate rating change\n- Update weekly/monthly stats

SP -> DB : UPDATE user_statistics\nSET wins = wins + 1,\ncurrent_rating = newRating, ...
activate DB
DB --> SP : Statistics updated
deactivate DB

SP -> CACHE : Invalidate cached stats\nfor user
activate CACHE
CACHE --> SP : Cache cleared
deactivate CACHE
deactivate SP

WS -> FE : {type: "game_ended", \nresult: "win", \nratingChange: +23,\nnewRating: 1268}
FE -> FE : Update UI with new stats
FE -> U : Show game result &\nrating change
deactivate WS

