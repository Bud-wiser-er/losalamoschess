' ============================================
' GAME INITIALIZATION AND PLAYER MOVE VALIDATION
' ============================================

@startuml Game_Initialization_and_Move_Flow
title Complete Game Flow - Initialization to Move Processing

actor User as U
participant "Frontend\n(Dashboard)" as FE
participant "WebSocket Server\n(clean-server.js)" as WS
participant "RulesEngine\n(Byron)" as RE
participant "AIBot\n(Byron)" as AI
participant "Database" as DB
participant "Game State\nManager" as GM

== Game Initialization ==
U -> FE : Select bot level (L0-L4)\nand optional ELO
activate FE
FE -> FE : Validate selection\n& construct game URL
FE -> U : Redirect to game_view.html\n?botLevel=L3&elo=2000
deactivate FE

U -> FE : Load game page
activate FE
FE -> FE : Parse URL parameters\n(botLevel, elo)
FE -> FE : Initialize board\n& WebSocket connection
FE -> WS : {type: "join_game",\n botLevel: "L3",\n elo: 2000}
activate WS

WS -> GM : Create new game session
activate GM
GM -> GM : Generate unique gameId
GM -> GM : Initialize game state\n{fen: startFEN, players: {}}
GM -> WS : Store bot configuration\n{botLevel: "L3", elo: 2000}
deactivate GM

WS -> FE : {type: "game_joined",\n gameId: "abc123",\n yourColor: "white"}
FE -> U : Display board & bot info\n"vs L3 - Enhanced (~2000 ELO)"
deactivate WS

== Human Move Processing ==
U -> FE : Drag piece from e2 to e4
activate FE
FE -> FE : Validate drag legality\n& construct UCI move
FE -> WS : {type: "player_move",\n move: "e2e4",\n gameId: "abc123"}
activate WS

WS -> DB : Fetch current game state
activate DB
DB --> WS : {fen, moveHistory, gameStatus}
deactivate DB

WS -> RE : validateMove(currentFen, "e2e4")
activate RE
RE -> RE : Parse and validate FEN
RE -> RE : Check UCI format validity
RE -> RE : Verify piece ownership\n(white's turn)
RE -> RE : Calculate legal moves\nfor piece at e2
RE -> RE : Check move legality\n& board boundaries
RE -> RE : Simulate move & verify\nking not in check
RE --> WS : {valid: true,\n moveType: "normal",\n capture: false}
deactivate RE

alt Move is valid
    WS -> RE : applyMove(currentFen, "e2e4")
    activate RE
    RE -> RE : Execute move on board
    RE -> RE : Update piece positions
    RE -> RE : Generate new FEN string
    RE -> RE : Check for check/checkmate
    RE -> RE : Determine game status
    RE --> WS : {newFen: "rnbqkbnr/pppppppp...",\n san: "e4",\n gameStatus: "ongoing",\n isCheck: false}
    deactivate RE

    WS -> DB : Save move to history
    activate DB
    DB -> DB : Insert move record\n{gameId, move, fen, timestamp}
    DB --> WS : Move saved successfully
    deactivate DB

    WS -> FE : {type: "move_applied",\n fen: newFen,\n san: "e4",\n turn: "black"}
    FE -> FE : Update board display\n& switch turn indicator
    FE -> U : Show updated position

    == AI Move Processing ==
    WS -> WS : Check if opponent is bot
    WS -> WS : Retrieve bot configuration\n{botLevel: "L3", elo: 2000}
    WS -> AI : {type: "ai_move_request",\n fen: newFen,\n level: "L3",\n elo: 2000,\n msCap: 5000}
    activate AI

    AI -> AI : Select strategy based on level
    AI -> AI : Execute L3 Enhanced strategy\n(minimax + optimizations)
    AI -> RE : getLegalMoves(newFen)
    activate RE
    RE --> AI : [legal moves array]
    deactivate RE

    loop Minimax search with depth 3
        AI -> AI : Evaluate positions
        AI -> AI : Apply alpha-beta pruning
        AI -> AI : Check time constraints
    end

    AI -> AI : Select best move\nbased on evaluation
    AI --> WS : {ok: true,\n move: "e7e5",\n eval: 0.15,\n depth: 3,\n time: 2341}
    deactivate AI

    WS -> RE : validateMove(newFen, "e7e5")
    activate RE
    RE --> WS : {valid: true}
    deactivate RE

    WS -> RE : applyMove(newFen, "e7e5")
    activate RE
    RE -> RE : Apply AI move
    RE -> RE : Check for checkmate/stalemate
    RE --> WS : {newFen: "...", san: "e5", gameStatus: "ongoing"}
    deactivate RE

    WS -> DB : Save AI move
    activate DB
    DB --> WS : Success
    deactivate DB

    WS -> FE : {type: "ai_move",\n fen: finalFen,\n san: "e5",\n turn: "white",\n metadata: {eval: 0.15, time: 2341}}
    FE -> FE : Update board & display\nAI move with animation
    FE -> U : Show AI's move\n& evaluation

else Move is invalid
    WS -> FE : {type: "move_error",\n error: "ILLEGAL_MOVE",\n details: "Piece cannot move there"}
    FE -> FE : Reset piece position
    FE -> U : Show error notification\n& restore board state
end

deactivate WS
deactivate FE

@enduml

' ============================================
' AI BOT MOVE GENERATION SEQUENCE
' ============================================

@startuml AI_Bot_Strategy_Details
title Detailed AI Bot Strategy Implementation

participant "WebSocket Server" as WS
participant "AIBot Manager" as AI
participant "L0 Random\nStrategy" as L0
participant "L1 Greedy\nStrategy" as L1
participant "L2 Minimax\nStrategy" as L2
participant "L3 Enhanced\nStrategy" as L3
participant "L4 Fairy-Stockfish\nEngine" as L4
participant "Position\nEvaluator" as EV
participant "RulesEngine" as RE

== Strategy Selection and Execution ==
WS -> AI : generateMove({fen, level: "L3", elo: 2000, msCap: 5000})
activate AI

AI -> AI : Parse bot level\n& validate parameters
AI -> AI : Select strategy instance\nbased on level

alt Level L0 - Random Strategy
    AI -> L0 : findBestMove(fen, msCap)
    activate L0
    L0 -> RE : getLegalMoves(fen)
    activate RE
    RE --> L0 : [e2e4, d2d4, g1f3, ...]
    deactivate RE
    L0 -> L0 : Math.random() selection
    L0 --> AI : {move: "e2e4", eval: 0.0, depth: 0}
    deactivate L0

else Level L1 - Greedy Strategy
    AI -> L1 : findBestMove(fen, msCap)
    activate L1
    L1 -> RE : getLegalMoves(fen)
    activate RE
    RE --> L1 : [all legal moves]
    deactivate RE

    loop For each move
        L1 -> RE : applyMove(fen, move)
        activate RE
        RE --> L1 : resultingFen
        deactivate RE
        L1 -> EV : evaluatePosition(resultingFen)
        activate EV
        EV -> EV : Count material\n& basic position factors
        EV --> L1 : materialScore
        deactivate EV
    end
    L1 -> L1 : Select move with\nhighest immediate gain
    L1 --> AI : {move: "exd5", eval: 1.2, depth: 1}
    deactivate L1

else Level L2 - Minimax Strategy
    AI -> L2 : findBestMove(fen, msCap)
    activate L2
    L2 -> L2 : Initialize search\n(depth: 2, alpha-beta)
    L2 -> RE : getLegalMoves(fen)
    activate RE
    RE --> L2 : [root moves]
    deactivate RE

    loop For each root move
        L2 -> L2 : minimax(position, depth=2,\n alpha, beta, maximizing)
        loop Recursive minimax
            L2 -> RE : getLegalMoves(position)
            activate RE
            RE --> L2 : [moves at depth]
            deactivate RE
            L2 -> EV : evaluatePosition(leafNode)
            activate EV
            EV --> L2 : positionScore
            deactivate EV
            L2 -> L2 : Alpha-beta pruning
        end
    end
    L2 -> L2 : Select move with\nbest minimax value
    L2 --> AI : {move: "Nf3", eval: 0.3, depth: 2}
    deactivate L2

else Level L3 - Enhanced Strategy
    AI -> L3 : findBestMove(fen, msCap)
    activate L3
    L3 -> L3 : Initialize enhanced search\n(depth: 3, TT, move ordering)
    L3 -> L3 : Check transposition table
    L3 -> L3 : Generate & order moves\n(captures first, killer moves)

    loop Iterative deepening (1 to 3)
        L3 -> RE : getLegalMoves(position)
        activate RE
        RE --> L3 : [ordered moves]
        deactivate RE

        loop For each move (ordered)
            L3 -> L3 : Search with\nenhanced pruning
            L3 -> EV : evaluatePosition(position)
            activate EV
            EV -> EV : Material + positional\n+ king safety + mobility
            EV --> L3 : enhancedScore
            deactivate EV
            L3 -> L3 : Store in TT

            alt Time limit check
                L3 -> L3 : Return best move so far
            end
        end
    end
    L3 --> AI : {move: "Be2", eval: 0.45, depth: 3, nodes: 15420}
    deactivate L3

else Level L4 - Fairy-Stockfish Engine
    AI -> L4 : findBestMove(fen, elo, msCap)
    activate L4
    L4 -> L4 : Configure engine strength\nbased on ELO (1000-3000)
    L4 -> L4 : Set search parameters\n(depth, time, nodes)
    L4 -> L4 : Start engine analysis

    loop Engine search
        L4 -> L4 : Advanced search algorithms\n(NNUE eval, deep pruning)
        L4 -> L4 : Multi-threaded analysis
        L4 -> L4 : Opening book lookup
        L4 -> L4 : Endgame tablebase
    end

    L4 -> L4 : Apply ELO limitation\n(reduce strength if needed)
    L4 --> AI : {move: "d4", eval: 1.15, depth: 12, engine: "fairy-stockfish"}
    deactivate L4
end

== Move Validation and Response ==
AI -> RE : validateMove(fen, selectedMove)
activate RE
RE -> RE : Verify move legality\n& format correctness
RE --> AI : {valid: true, moveType: "normal"}
deactivate RE

AI -> AI : Compile response with\nmetadata & timing info

AI --> WS : {ok: true, move: selectedMove, eval: evaluationScore, depth: searchDepth, time: elapsedMs, strategy: "L3"}
deactivate AI

note right of WS
  Each strategy has different
  characteristics:
  - L0: Pure randomness
  - L1: Tactical awareness
  - L2: Strategic planning
  - L3: Advanced techniques
  - L4: World-class engine
end note

@enduml

