' ============================================
' ERROR HANDLING SEQUENCE
' ============================================

@startuml Comprehensive_Error_Handling
title Comprehensive Error Handling and Edge Cases

participant "Frontend" as FE
participant "WebSocket Server" as WS
participant "RulesEngine" as RE
participant "AIBot" as AI
participant "Database" as DB
participant "Game State" as GS

== Input Validation Errors ==
FE -> WS : {type: "player_move", move: "invalid-format", gameId: "123"}
activate WS
WS -> WS : Validate message format
WS --> FE : {type: "error", code: "INVALID_MESSAGE_FORMAT", details: "Move format must be UCI"}
deactivate WS

== Game State Errors ==
FE -> WS : {type: "player_move", move: "e2e4", gameId: "nonexistent"}
activate WS
WS -> DB : fetchGameState("nonexistent")
activate DB
DB --> WS : null (game not found)
deactivate DB
WS --> FE : {type: "error", code: "GAME_NOT_FOUND", details: "Game session expired or invalid"}
deactivate WS

== Move Validation Errors ==
FE -> WS : {type: "player_move", move: "e2e4", gameId: "123"}
activate WS
WS -> GS : getCurrentFEN("123")
activate GS
GS --> WS : "invalid-fen-string"
deactivate GS

WS -> RE : validateMove("invalid-fen-string", "e2e4")
activate RE
RE -> RE : Parse FEN string
RE --> WS : {valid: false, error: "INVALID_FEN", details: "Malformed FEN string"}
deactivate RE
WS --> FE : {type: "move_error", error: "INVALID_BOARD_STATE", recovery: "refresh_required"}
deactivate WS

== Chess Rule Violations ==
FE -> WS : {type: "player_move", move: "e1g1", gameId: "123"}
activate WS
WS -> RE : validateMove(validFen, "e1g1")
activate RE
RE -> RE : Check castling legality
RE -> RE : Verify king hasn't moved
RE -> RE : Check for pieces between
RE -> RE : Verify no check conditions
RE --> WS : {valid: false, error: "ILLEGAL_CASTLING", details: "King has moved previously"}
deactivate RE
WS --> FE : {type: "move_error", error: "ILLEGAL_CASTLING", suggestion: "King cannot castle after moving"}
deactivate WS

== Turn Order Violations ==
FE -> WS : {type: "player_move", move: "e7e5", gameId: "123"}
activate WS
WS -> GS : getCurrentTurn("123")
activate GS
GS --> WS : "white"
deactivate GS
WS -> WS : Check if player is white
WS --> FE : {type: "move_error", error: "NOT_YOUR_TURN", details: "Wait for opponent's move"}
deactivate WS

== AI Bot Errors ==
WS -> AI : generateMove({fen: validFen, level: "L99", msCap: 5000})
activate AI
AI -> AI : Validate bot level
AI --> WS : {ok: false, error: "INVALID_BOT_LEVEL", validLevels: ["L0", "L1", "L2", "L3", "L4"]}
deactivate AI

== AI Timeout Handling ==
WS -> AI : generateMove({fen: complexPosition, level: "L3", msCap: 1000})
activate AI
AI -> AI : Start minimax search
AI -> AI : Monitor time elapsed

alt Search completes in time
    AI --> WS : {ok: true, move: "Nf3", eval: 0.3, time: 850}
else Timeout reached
    AI -> AI : Return best move found so far
    AI --> WS : {ok: true, move: "e7e5", eval: 0.1, time: 1000, timeout: true}
end
deactivate AI

== Database Connection Errors ==
WS -> DB : saveMove({gameId: "123", move: "e2e4", fen: newFen})
activate DB
DB -> DB : Attempt database connection
DB --> WS : {error: "CONNECTION_FAILED", retry: true}
deactivate DB

WS -> WS : Implement retry logic
WS -> DB : saveMove (retry attempt)
activate DB
DB --> WS : {success: true, moveId: 456}
deactivate DB

== Game End State Detection ==
WS -> RE : applyMove(fen, "Qh8#")
activate RE
RE -> RE : Apply move to board
RE -> RE : Check for checkmate
RE -> RE : Verify no legal moves remain
RE --> WS : {newFen: finalFen, gameStatus: "checkmate", winner: "white"}
deactivate RE

WS -> GS : updateGameStatus("123", "completed", "white")
activate GS
GS --> WS : {success: true}
deactivate GS

WS --> FE : {type: "game_ended", reason: "checkmate", winner: "white", finalFen: finalFen}

== Stalemate Detection (Needs Improvement) ==
WS -> RE : applyMove(fen, moveResult)
activate RE
RE -> RE : Check if king is in check
RE -> RE : Generate all legal moves
RE -> RE : Count available moves

alt No legal moves and king not in check
    RE --> WS : {gameStatus: "stalemate", draw: true}
else Insufficient material detected
    RE -> RE : Count remaining pieces
    RE --> WS : {gameStatus: "insufficient_material", draw: true}
else 50-move rule or repetition
    RE --> WS : {gameStatus: "draw_by_rule", draw: true}
end
deactivate RE

note over RE
  TODO: Improve stalemate detection
  for positions where pieces remain
  but checkmate is impossible
  (e.g., only kings + bishops on
  opposite colors)
end note

== Connection Loss Recovery ==
FE -> WS : WebSocket connection lost
WS -> WS : Clean up game session
WS -> GS : markPlayerDisconnected("123", "white")

FE -> WS : Reconnect attempt
WS -> WS : Validate session token
WS -> GS : restoreGameState("123")
activate GS
GS --> WS : {fen, moveHistory, gameStatus}
deactivate GS
WS --> FE : {type: "game_restored", fen: currentFen, yourTurn: false}

@enduml

