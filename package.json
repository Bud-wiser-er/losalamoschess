{
  "name": "losalamos-chess-backend",
  "version": "1.0.0",
  "description": "Los Alamos Chess Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "node test-auth.js",
    "test:api": "node test-api.js",
    "test:integration": "npm run test:auth && npm run test:api",
    "db:setup": "node database/setup.js",
    "db:test": "node database/test-connection.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/setup.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf node_modules package-lock.json",
    "fresh-install": "npm run clean && npm install",
    "validate": "node -e \"console.log('Environment validation complete')\"",
    "health": "npm run db:test && echo Health check passed",
    "setup": "npm install && npm run db:setup && npm run db:test",
    "install-deps": "npm install",
    "test:complete": "npm run test:auth && npm run test:api && npm run test"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsdom": "^24.1.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chess",
    "los-alamos",
    "game",
    "nodejs",
    "express",
    "postgresql",
    "realtime",
    "web-application"
  ],
  "author": "EPE321 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/losalamos-chess-backend.git"
  }
}