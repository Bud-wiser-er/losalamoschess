{
  "name": "los-alamos-chess-backend",
  "version": "1.0.0",
  "description": "Los Alamos Chess Platform - Backend Game Logic",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node src/cli/main_entry_index.js",
    "dev": "nodemon src/cli/main_entry_index.js",
    "demo": "node src/cli/main_entry_index.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit-tests",
    "test:step": "node unit-tests/test-steps.js",
    "test:auth": "node test-auth.js",
    "test:api": "node test-api.js",
    "test:integration": "npm run test:auth && npm run test:api",
    "test:complete": "npm run test:auth && npm run test:api && npm run test",
    "test:byron:file-loading": "node backend/unit-tests/test-file-loading.js",
    "test:server": "node security_server_tester.js",
    "test:byron:board-validator": "node backend/unit-tests/test-board-validator.js",
    "test:byron:piece-movement": "node backend/unit-tests/test-piece-movement.js",
    "test:byron:debug_piece_movement": "node backend/unit-tests/test-even-more-piece-movement.js",
    "test:byron:rules-engine": "node backend/unit-tests/test-rules-engine.js",
    "test:byron:ai-bot": "node backend/unit-tests/test-ai-bot.js",
    "test:byron:stress": "node backend/unit-tests/stress-test.js",
    "test:byron:ai-stress": "node backend/unit-tests/test-ai-bot-stress.js",
    "test:byron:debug-fen": "node backend/unit-tests/debug-fen-issue.js",
    "test:byron:debug-ai": "node backend/unit-tests/debug-ai-bot.js",
    "test:byron:fairy-stockfish": "node backend/unit-tests/test-fairy-stockfish.js",
    "test:byron:fairy-stockfish-stress": "node backend/unit-tests/test-fairy-stockfish-stress.js",
    "test:byron:l4-bot": "node backend/unit-tests/test-l4-bot.js",
    "test:byron:all": "npm run -s test:byron:file-loading && npm run -s test:byron:board-validator && npm run -s test:byron:piece-movement && npm run -s test:byron:rules-engine && npm run -s test:byron:ai-bot && npm run -s test:byron:ai-stress && npm run -s test:byron:stress",
    "test:byron:quick": "npm run test:byron:file-loading && npm run test:byron:board-validator",
    "db:setup": "node database/setup.js",
    "db:test": "node database/test-connection.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/setup.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf node_modules package-lock.json",
    "fresh-install": "npm run clean && npm install",
    "validate": "node -e \"console.log('Environment validation complete')\"",
    "health": "npm run db:test && echo Health check passed",
    "setup": "npm install && npm run db:setup && npm run test:db",
    "install-deps": "npm install"
  },
  "keywords": [
    "chess",
    "los-alamos",
    "game-engine",
    "ai",
    "board-game",
    "nodejs",
    "express",
    "postgresql",
    "realtime",
    "web-application"
  ],
  "author": "EPE321 Team 14",
  "contributors": [
    {
      "name": "Byron"
    },
    {
      "name": "Nastasha"
    },
    {
      "name": "Arno"
    },
    {
      "name": "Lizzy"
    },
    {
      "name": "Ethan"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/losalamos-chess-backend.git"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsdom": "^24.1.1",
    "jsonwebtoken": "^9.0.2",
    "node-uci": "^1.3.4",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.3.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "typescript-eslint": "^8.44.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "<rootDir>/unit-tests/**/*.test.js",
      "<rootDir>/unit-tests/**/*.spec.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/unit-tests/"
    ],
    "rootDir": ".",
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
